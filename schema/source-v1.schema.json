{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nagare-project/Nagare_Source/main/schema/source-v1.schema.json",
  "title": "Nagare Source Spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "kind", "tier", "origin", "search", "resolve", "defaults"],
  "properties": {
    "schema": { "const": "nagare-source/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 500 },
    "icon": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "kind": { "enum": ["web", "bt"] },
    "tier": { "type": "integer", "minimum": 0, "maximum": 9 },
    "channel_tiers": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 99 }
    },
    "enabled": { "type": "boolean", "default": true },
    "origin": { "$ref": "#/$defs/origin" },
    "search": { "$ref": "#/$defs/searchStage" },
    "episodes": { "$ref": "#/$defs/episodesStage" },
    "resolve": { "$ref": "#/$defs/resolveStage" },
    "defaults": { "$ref": "#/$defs/defaults" },
    "matching": { "$ref": "#/$defs/matching" },
    "ranking": { "$ref": "#/$defs/ranking" },
    "cache": { "$ref": "#/$defs/cache" },
    "limits": { "$ref": "#/$defs/limits" },
    "selftest": { "$ref": "#/$defs/selftest" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "web" } }, "required": ["kind"] },
      "then": {
        "required": ["episodes"],
        "properties": {
          "resolve": {
            "properties": { "transport": { "enum": ["auto", "hls", "http"] } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "bt" } }, "required": ["kind"] },
      "then": {
        "not": { "required": ["episodes"] },
        "properties": {
          "resolve": {
            "properties": {
              "mode": { "const": "direct" },
              "transport": { "enum": ["torrent", "magnet", "torrent_file"] }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "upstream", "version", "license"],
      "properties": {
        "ecosystem": { "enum": ["community", "animeko", "kazumi", "nagare-v1"] },
        "upstream": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "version": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "headers": {
      "type": "object",
      "propertyNames": { "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$" },
      "additionalProperties": { "type": "string" }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "url", "allowed_hosts"],
      "properties": {
        "method": { "enum": ["GET", "POST"] },
        "url": { "type": "string", "pattern": "^(?:https?://|\\{\\{[a-z][a-z0-9_]*\\}\\}$)", "minLength": 10 },
        "query": { "$ref": "#/$defs/stringMap" },
        "headers": { "$ref": "#/$defs/headers" },
        "body": { "type": "string" },
        "form": { "$ref": "#/$defs/stringMap" },
        "allowed_hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:\\*\\.)?[A-Za-z0-9.-]+$" }
        },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "max_bytes": { "type": "integer", "minimum": 1024, "maximum": 52428800 },
        "max_redirects": { "type": "integer", "minimum": 0, "maximum": 10 }
      },
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "GET" } }, "required": ["method"] },
          "then": { "not": { "anyOf": [{ "required": ["body"] }, { "required": ["form"] }] } }
        },
        {
          "not": { "required": ["body", "form"] }
        }
      ]
    },
    "responseType": { "enum": ["json", "html", "xml", "rss", "text"] },
    "transform": {
      "oneOf": [
        {
          "enum": [
            "trim", "lowercase", "uppercase", "html_decode", "url_decode",
            "absolute_url", "parse_episode", "parse_size", "parse_datetime",
            "normalize_infohash", "parse_fansub"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["regex", "replace", "prepend", "append", "default", "parse_size", "parse_datetime", "magnet"] },
            "pattern": { "type": "string", "minLength": 1 },
            "replacement": { "type": "string" },
            "value": { "type": ["string", "number", "boolean"] },
            "group": { "type": "integer", "minimum": 0 },
            "unit": { "enum": ["B", "KB", "unix_seconds", "unix_milliseconds", "rfc3339", "auto"] },
            "display_name_from": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "trackers": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "format": "uri" }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "type": { "enum": ["regex", "replace"] } }, "required": ["type"] },
              "then": { "required": ["pattern"] }
            },
            {
              "if": { "properties": { "type": { "const": "replace" } }, "required": ["type"] },
              "then": { "required": ["replacement"] }
            },
            {
              "if": { "properties": { "type": { "enum": ["prepend", "append", "default"] } }, "required": ["type"] },
              "then": { "required": ["value"] }
            }
          ]
        }
      ]
    },
    "extractor": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["jsonpath", "css", "xpath", "regex", "field", "template"] },
            "expression": { "type": "string", "minLength": 1 },
            "attribute": { "type": "string", "minLength": 1 },
            "group": { "type": "integer", "minimum": 0 },
            "scope": { "enum": ["item", "document"] },
            "any": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/extractor" }
            },
            "transforms": {
              "type": "array",
              "items": { "$ref": "#/$defs/transform" }
            },
            "required": { "type": "boolean", "default": true }
          },
          "oneOf": [
            {
              "required": ["type", "expression"],
              "not": { "required": ["any"] }
            },
            {
              "required": ["any"],
              "not": { "anyOf": [{ "required": ["type"] }, { "required": ["expression"] }] }
            }
          ]
        }
      ]
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/extractor" }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "mode": { "enum": ["items", "zipped"] },
        "items": { "$ref": "#/$defs/extractor" },
        "fields": { "$ref": "#/$defs/fields" }
      },
      "oneOf": [
        {
          "required": ["items"],
          "properties": { "mode": { "const": "items" } }
        },
        {
          "required": ["mode"],
          "properties": { "mode": { "const": "zipped" } },
          "not": { "required": ["items"] }
        }
      ]
    },
    "searchStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "response", "fields"],
      "properties": {
        "request": { "$ref": "#/$defs/request" },
        "response": { "$ref": "#/$defs/responseType" },
        "mode": { "enum": ["items", "zipped"] },
        "base_url": { "type": "string", "pattern": "^https?://" },
        "namespaces": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" },
          "additionalProperties": { "type": "string", "format": "uri" }
        },
        "items": { "$ref": "#/$defs/extractor" },
        "fields": { "$ref": "#/$defs/fields" }
      },
      "oneOf": [
        {
          "required": ["items"],
          "properties": { "mode": { "const": "items" } }
        },
        {
          "required": ["mode"],
          "properties": { "mode": { "const": "zipped" } },
          "not": { "required": ["items"] }
        }
      ]
    },
    "episodesStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "response"],
      "properties": {
        "request": { "$ref": "#/$defs/request" },
        "response": { "$ref": "#/$defs/responseType" },
        "mode": { "enum": ["items", "zipped"] },
        "base_url": { "type": "string", "pattern": "^https?://" },
        "items": { "$ref": "#/$defs/extractor" },
        "fields": { "$ref": "#/$defs/fields" },
        "variables": { "$ref": "#/$defs/fields" },
        "lines": { "$ref": "#/$defs/lineCollection" }
      },
      "oneOf": [
        {
          "required": ["items", "fields"],
          "properties": { "mode": { "const": "items" } },
          "not": { "required": ["lines"] }
        },
        {
          "required": ["mode", "fields"],
          "properties": { "mode": { "const": "zipped" } },
          "not": { "anyOf": [{ "required": ["items"] }, { "required": ["lines"] }] }
        },
        {
          "required": ["lines"],
          "not": { "anyOf": [{ "required": ["mode"] }, { "required": ["items"] }, { "required": ["fields"] }] }
        }
      ]
    },
    "lineCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "fields", "episodes"],
      "properties": {
        "items": { "$ref": "#/$defs/extractor" },
        "fields": { "$ref": "#/$defs/fields" },
        "episodes": { "$ref": "#/$defs/collection" }
      }
    },
    "resolveStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "transport", "url"],
      "properties": {
        "mode": { "enum": ["direct", "browser_sniff"] },
        "transport": { "enum": ["auto", "hls", "http", "torrent", "magnet", "torrent_file"] },
        "url": { "type": "string", "minLength": 1 },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "allow_verified_media": { "type": "boolean", "default": false },
            "exclude": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "nested_include": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "capture_group": {
              "oneOf": [
                { "type": "integer", "minimum": 0 },
                { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" }
              ]
            }
          }
        },
        "request_headers": { "$ref": "#/$defs/headers" },
        "cookie_policy": { "enum": ["none", "source"] },
        "cookies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[^=;\\s]+=[^;]*$" }
        },
        "allowed_hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:\\*\\.)?[A-Za-z0-9.-]+$" }
        },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 60000 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "browser_sniff" } }, "required": ["mode"] },
          "then": { "required": ["match", "allowed_hosts"] }
        }
      ]
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resolution": {
          "enum": ["360P", "480P", "720P", "1080P", "1440P", "2160P"]
        },
        "subtitle_languages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" }
        },
        "channel_tier": { "type": "integer", "minimum": 0, "maximum": 99 }
      }
    },
    "matching": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "search_first_word_only": { "type": "boolean" },
        "search_remove_special": { "type": "boolean" },
        "search_title_limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "require_episode": { "type": "boolean" },
        "require_subject": { "type": "boolean" },
        "distinguish_subject": { "type": "boolean" },
        "distinguish_channel": { "type": "boolean" }
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priority": { "type": "integer", "minimum": -100000, "maximum": 100000 },
        "has_seeders": { "type": "boolean" }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttl_ms": { "type": "integer", "minimum": 0, "maximum": 2592000000 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
        "requests_per_minute": { "type": "integer", "minimum": 1, "maximum": 600 },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 120000 },
        "max_response_bytes": { "type": "integer", "minimum": 1024, "maximum": 52428800 },
        "max_redirects": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "selftest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "expect"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "query": { "type": "string", "minLength": 1 },
            "titles": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "episode": { "type": "number", "exclusiveMinimum": 0 }
          },
          "oneOf": [
            {
              "required": ["query"],
              "not": { "anyOf": [{ "required": ["titles"] }, { "required": ["episode"] }] }
            },
            {
              "required": ["titles", "episode"],
              "not": { "required": ["query"] }
            }
          ]
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_candidates"],
          "properties": {
            "min_candidates": { "type": "integer", "minimum": 0 },
            "transport": { "enum": ["hls", "http", "torrent"] }
          }
        }
      }
    }
  }
}
