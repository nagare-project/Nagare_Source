{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nagare-project/Nagare_Source/main/schema/repository-index-v1.schema.json",
  "title": "Nagare source repository index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "generatedAt", "sourceSchemaVersions", "artifacts", "sources"],
  "properties": {
    "schema": { "const": "nagare-repository-index/v1" },
    "version": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceSchemaVersions": {
      "type": "array",
      "const": [1]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["btIndex", "health"],
      "properties": {
        "btIndex": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "format", "schemaVersion", "records", "digest"],
          "properties": {
            "path": { "const": "bt-index.sqlite.zst" },
            "format": { "const": "sqlite3+zstd" },
            "schemaVersion": { "const": 1 },
            "records": { "type": "integer", "minimum": 0 },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "format", "schemaVersion", "generatedAt", "digest"],
          "properties": {
            "path": { "const": "health.json" },
            "format": { "const": "json" },
            "schemaVersion": { "const": 1 },
            "generatedAt": { "type": "string", "format": "date-time" },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceEntry" }
    }
  },
  "$defs": {
    "sourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "tier", "version", "path", "digest", "capabilities", "origin"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["web", "bt"] },
        "tier": { "type": "integer", "minimum": 0, "maximum": 9 },
        "version": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^sources/[a-z0-9-]+\\.json$" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["web", "bt", "direct", "browser_sniff"] }
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ecosystem", "upstream", "license"],
          "properties": {
            "ecosystem": { "enum": ["community", "animeko", "kazumi", "nagare-v1"] },
            "upstream": { "type": "string", "format": "uri", "pattern": "^https?://" },
            "license": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
